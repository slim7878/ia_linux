# Hermes Agent — clé d'authentification API (min. 8 caractères)
# Générer avec : openssl rand -hex 32
HERMES_API_KEY=your-api-key-here

# Hermes Dashboard (optionnel)
# HERMES_DASHBOARD_USER=admin
# HERMES_DASHBOARD_PASSWORD=your-password-here
# HERMES_DASHBOARD_SECRET=your-secret-here

# Telegram (optionnel)
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_ALLOWED_USERS=123456789
# TELEGRAM_HOME_CHANNEL=

# OpenAI (optionnel)
# OPENAI_API_KEY=sk-...

# ClickUp (optionnel)
# CLICKUP_API_TOKEN=your-token-here

# Qwen3.8-27B (optionnel, profil qwen38)
# QWEN38_API_KEY=          # laisser vide = pas d'auth
# QWEN38_SPEC=dflash2      # moteur de spéculation recommandé en usage solo
# QWEN38_PREFIX_CACHE=1    # cache de préfixe recommandé
# QWEN38_DFLASH_TOKENS=7   # tokens draft par étape
